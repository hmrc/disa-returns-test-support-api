meta {
  name: Set reporting window override
  type: http
  seq: 2
}

put {
  url: {{API_BASE}}/test/obligations/declaration/isa/return/monthly/{{zReference}}/reporting-window-override
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "startDate": "{{reportingWindowStart}}",
    "endDate": "{{reportingWindowEnd}}"
  }
}
